#!/usr/bin/env bash
# Portable release checks for omaLinea. Runs anywhere with bash + python3.
# Host checks (omarchy CLI, qmllint) run when available, skip otherwise.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FAIL=0

fail() { echo "FAIL: $1"; FAIL=1; }
pass() { echo "ok: $1"; }

# 1. manifest.json parses and declares the contract surface.
MANIFEST="$ROOT/manifest.json"
[ -f "$MANIFEST" ] || { fail "manifest.json missing"; }
python3 - "$MANIFEST" <<'EOF'
import json, sys
m = json.load(open(sys.argv[1]))
assert m["id"] == "rene.lalinea", "id"
assert m["version"], "version"
eps = m["entryPoints"]
for kind, path in (("overlay", eps.get("overlay")), ("barWidget", eps.get("barWidget"))):
    assert path, f"entryPoints.{kind}"
print("manifest:", m["id"], m["version"], sorted(m["kinds"]))
EOF
[ $? -eq 0 ] && pass "manifest parses" || fail "manifest parses"

# 2. Every mapped entry point exists.
for f in LaLinea.qml BarIcon.qml; do
  [ -f "$ROOT/$f" ] && pass "$f present" || fail "$f present"
done

# 3. Full source coverage: all 28 complete episodes and bounded WebP parts.
python3 - "$ROOT" <<'EOF'
import math, re, runpy, sys
from pathlib import Path
root = Path(sys.argv[1])
starts = runpy.run_path(str(root / "tools/generate_episodes.py"))["STARTS"]
qml = (root / "LaLinea.qml").read_text()
qml_starts = re.search(r"var starts = \[([^]]+)\]", qml, re.S)
assert qml_starts, "QML episode catalog missing"
assert [float(n) for n in qml_starts.group(1).replace("\n", "").split(",")] == list(starts), "QML boundaries differ from generated media"
assert len(starts) == 29 and starts[0] == 0 and starts[-1] > 4345
assert all(150 <= b-a <= 161 for a,b in zip(starts,starts[1:])), "episode boundary"
expected = set()
for index, (start, end) in enumerate(zip(starts, starts[1:])):
    number = index + 101
    expected.add(f"{number}.ogg")
    for part in range(math.ceil((end-start) / 30)):
        expected.add(f"{number}-{part:02d}.webp")
actual = {p.name for p in (root / "episodes").iterdir() if p.is_file()}
assert actual == expected, f"missing={expected-actual}, unexpected={actual-expected}"
for file in (root / "episodes").iterdir():
    with file.open("rb") as data:
        magic = data.read(12)
    if file.suffix == ".webp":
        assert magic[:4] == b"RIFF" and magic[8:] == b"WEBP", file
    else:
        assert magic[:4] == b"OggS", file
print(f"episodes: {len(starts)-1}; assets: {len(expected)}")
EOF
[ $? -eq 0 ] && pass "all full-episode media present" || fail "episode media"

if command -v ffprobe >/dev/null 2>&1; then
  frames=$(ffprobe -v error -count_frames -show_entries stream=nb_read_frames -of default=noprint_wrappers=1:nokey=1 "$ROOT/episodes/101-00.webp")
  [ "$frames" -gt 0 ] && [ "$frames" -le 240 ] && pass "WebP chunk frame budget" || fail "WebP chunk frame budget: $frames"
fi

# 4. Size budget: no giant files (WebP frame budget is covered above).
big=$(python3 - "$ROOT" <<'EOF'
import os, sys
root = sys.argv[1]
over = [f for f in os.listdir(root) if os.path.isfile(os.path.join(root, f)) and os.path.getsize(os.path.join(root, f)) > 50 * 1024 * 1024]
print(" ".join(over))
EOF
)
[ -z "$big" ] && pass "no files over 50MB" || fail "oversize: $big"

# 5. QML lint when available (host/CI with Qt).
if command -v qmllint >/dev/null 2>&1; then
  qmllint "$ROOT/LaLinea.qml" "$ROOT/BarIcon.qml" && pass "qmllint" || fail "qmllint"
else
  echo "skip: qmllint not installed"
fi

# 6. Official Omarchy validation when on Omarchy.
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$ROOT" && pass "omarchy plugin validate" || fail "omarchy plugin validate"
else
  echo "skip: omarchy CLI not installed"
fi

[ "$FAIL" -eq 0 ] && echo "ALL PORTABLE CHECKS PASSED" || echo "CHECKS FAILED"
exit "$FAIL"
